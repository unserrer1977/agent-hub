# Agent Hub configuration — copy to .env and fill in real values.

# ---- GitHub token (needed to commit the deployment heat map to the site) ----
# Create a fine-grained Personal Access Token at https://github.com/settings/pat
# with "repo" / "Contents" write + "Metadata" read access to unserrer1977/david-levine.
# Leave empty to run the agent in "dry-run" mode (heat map generated but not pushed).
GITHUB_TOKEN=

# ---- Site repository & branch ----
# Repo to update: owner/repo  (defaults to the david.levine site)
SITE_REPO=unserrer1977/david-levine
# Branch to land the heatmap commit on (usually main so Railway redeploys the site)
SITE_BRANCH=main

# ---- GitHub identity for commits ----
GITHUB_USERNAME=agent-hub
GITHUB_EMAIL=agent-hub@users.noreply.github.com

# ---- Heat map window ----
# How many days of git activity to render (rows shown = ceil(HEATMAP_DAYS/7))
HEATMAP_DAYS=21

# ---- Agent runtime ----
# State file (persists "last run" / stats across restarts; point at a Railway
# Persistent Storage mount for durable state)
STATE_FILE=/app/state.json
# Scheduler check interval (seconds)
SCHEDULER_INTERVAL=30
